# CANable with Open-TV-COMAND/rbcan firmware: serial port and ROM DFU usable without sudo.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="52a4", GROUP="dialout", MODE="0660", SYMLINK+="rbcan", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", GROUP="plugdev", MODE="0664"
